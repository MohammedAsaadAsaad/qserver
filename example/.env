APP_NAME="Quds Task API"
APP_ENV=local
APP_KEY=super_secret_key_123
APP_HOST=127.0.0.1
APP_PORT=8000

# Options: postgres, mysql
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=quds_example_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# LOG_LEVEL=debug
QUDS_MONITOR=true

QUDS_INSIGHTS=true
QUDS_INSIGHTS_TOKEN=demo-insights

