# IDE / local tooling
.vscode/
doc/api/
.env
**/.env

# Exclude the full-stack demo app from the published package.
# It is a standalone Flutter + backend showcase and is not needed by consumers.
example_messaging/

# Never ship compiled executables or stray build artifacts.
*.exe
*.exe.old

# Runtime output only. A bare `storage/` pattern also matches
# lib/src/storage/ and dropped those files from 0.0.18 on pub.dev.
/storage/
example/storage/
example/lib/storage/
**/storage/logs/

